# Required for authorized exploration runs
WEBTESTER_AUTHORIZED=true

# Free LLM providers (optional — exploration works without them)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto:free

# LLM routing: groq | gemini | openrouter | none
WEBTESTER_LLM_PROVIDER=groq

# Persistence
DATABASE_URL=postgresql+psycopg://webtester:webtester@localhost:5432/webtester
WEBTESTER_DATA_DIR=./data

# Browser
WEBTESTER_HEADLESS=true
